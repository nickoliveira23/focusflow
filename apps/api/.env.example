# ========================================
# API server base
# ========================================
# URL do frontend permitida no CORS e usada nos redirects de OAuth.
# Exemplo local: http://localhost:5173
# Exemplo prod:  https://focusflow.app
FRONTEND_URL=http://localhost:5173

# Segredo usado para assinatura de cookies de sessao.
# Use um valor longo e aleatorio (32+ chars), nao commitar valor real.
# Exemplo: COOKIE_SECRET=7b2f... (gerado por password manager)
COOKIE_SECRET=replace_with_random_secret

# Connection string do PostgreSQL.
# Exemplo local: postgresql://localhost:5432/pomodoro
# Exemplo Neon:  postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/pomodoro?sslmode=require
DATABASE_URL=postgresql://localhost:5432/pomodoro

# ========================================
# Spotify OAuth
# ========================================
# Credenciais do app criado no Spotify Dashboard.
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# URI de callback cadastrada no Spotify Dashboard.
# Deve ser IDENTICA ao valor configurado no painel.
# Exemplo local: https://<seu-tunnel>.ngrok-free.app/api/auth/spotify/callback
# Exemplo prod:  https://api.focusflow.app/api/auth/spotify/callback
SPOTIFY_REDIRECT_URI=http://localhost:3001/api/auth/spotify/callback

# true  = usa modo mock local (sem chamar API real do Spotify)
# false = usa Spotify real
SPOTIFY_MOCK=false

# ========================================
# Google OAuth
# ========================================
# Credenciais do app no Google Cloud Console.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# URI de callback cadastrada no Google Cloud Console.
# Exemplo local: http://localhost:3001/api/auth/google/callback
# Exemplo prod:  https://api.focusflow.app/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# true  = login mock local
# false = Google OAuth real
GOOGLE_MOCK=true
