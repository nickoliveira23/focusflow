# URL base da API consumida pelo frontend.
# Exemplo local: http://localhost:3001
# Exemplo prod:  https://api.focusflow.app
VITE_API_BASE_URL=http://localhost:3001

# Toggle de recursos/UI de Spotify no frontend.
# true  = mostra controles e card Spotify
# false = esconde Spotify da UI
VITE_SPOTIFY_ENABLED=true
